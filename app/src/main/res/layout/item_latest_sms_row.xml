<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_latest_sms_row_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:textColor="#EC1B30"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="#1" />

        <TextView
            android:id="@+id/tv_latest_sms_row_sender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#222222"
            android:textSize="14sp"
            tools:text="10690000" />

        <TextView
            android:id="@+id/tv_latest_sms_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:textColor="#888888"
            android:textSize="12sp"
            tools:text="2026-07-12 16:30" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_latest_sms_row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="#555555"
        android:textSize="14sp"
        tools:text="【乡村基】您的订单已完成，欢迎再次光临。" />

</LinearLayout>
