<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件设置页：配置 2x4 组件右侧 4 个菜单指向的功能 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6F8"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_settings_title"
            android:textColor="#FF222222"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_settings_hint"
        android:textColor="#FF999999"
        android:textSize="13sp" />

    <!-- 4 个菜单配置行的容器，行内容在代码中动态生成 -->
    <LinearLayout
        android:id="@+id/widget_settings_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_module_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />
</LinearLayout>
